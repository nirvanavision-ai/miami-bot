# =============================================================================
# Miami Coastal Condo Rental Monitor -- environment configuration
# Copy to `.env` and fill in the keys for the providers you actually use.
# Every provider is optional: the pipeline enables a module only when its
# credentials are present, and logs a skip notice for the rest.
# =============================================================================

# -----------------------------------------------------------------------------
# MODULE 1 -- PRIMARY ACTIVE LISTING INGESTION
# -----------------------------------------------------------------------------

# --- RapidAPI (portal wrappers: Zillow / Realtor / Redfin) -------------------
# One key works across every RapidAPI marketplace host you are subscribed to.
# Get it at https://rapidapi.com/developer/security  (X-RapidAPI-Key)
RAPIDAPI_KEY=

# Marketplace hosts. Override only if you subscribe to a different provider;
# the defaults below are the most widely used wrappers.
RAPIDAPI_ZILLOW_HOST=zillow-com1.p.rapidapi.com
RAPIDAPI_REALTOR_HOST=realty-in-us.p.rapidapi.com
RAPIDAPI_REDFIN_HOST=redfin-com-data.p.rapidapi.com

# Comma-separated list of RapidAPI wrappers to enable: zillow,realtor,redfin
RAPIDAPI_ENABLED_SOURCES=zillow,realtor

# Endpoint paths for the Zillow wrapper. Several competing Zillow wrappers are
# sold on RapidAPI (Axesso among them) exposing the same data under different
# paths, so these are configurable. Set them to whatever your subscription's
# docs specify -- the field maps are path-tolerant and usually need no change.
#   default wrapper (zillow-com1):
RAPIDAPI_ZILLOW_SEARCH_PATH=/propertyExtendedSearch
RAPIDAPI_ZILLOW_DETAIL_PATH=/property
#   Axesso example -- confirm the paths against axesso.de/zillow-api before use:
#     RAPIDAPI_ZILLOW_HOST=axesso-zillow-data-service.p.rapidapi.com
#     RAPIDAPI_ZILLOW_SEARCH_PATH=/zillow/search
#     RAPIDAPI_ZILLOW_DETAIL_PATH=/zillow/property

# --- RealtyAPI ---------------------------------------------------------------
# Generic aggregator client. Base URL + auth style are configurable so the same
# adapter works against RealtyAPI-style vendors without a code change.
REALTYAPI_KEY=
REALTYAPI_BASE_URL=https://api.realtyapi.io/v1
# How the key is sent: header_x_api_key | header_bearer | query_param
REALTYAPI_AUTH_STYLE=header_x_api_key
# Query-string parameter name when REALTYAPI_AUTH_STYLE=query_param
REALTYAPI_AUTH_PARAM=api_key
# Path appended to the base URL for rental search
REALTYAPI_SEARCH_PATH=/properties/rentals

# --- Craigslist (NO KEY REQUIRED) --------------------------------------------
# Consumes Craigslist's published RSS feed, which they provide for automated
# readers. The only genuinely zero-credential source of active rentals here.
# Trade-off: no coordinates and no street address, so ocean distance and unit
# hashing degrade to warnings. Off by default.
CRAIGSLIST_ENABLED=false
# Comma-separated Craigslist regional sites.
CRAIGSLIST_SITES=miami

# --- RentCast as a LISTING source (free tier) --------------------------------
# RentCast's /listings/rental/long-term endpoint returns active rentals, not
# just AVMs. One call per ZIP (5 per run) fits the free tier comfortably.
# Set the key under MODULE 3 below; this only toggles its use as a source.
# Note: RentCast publishes no description or photos, so amenity and lease-term
# checks on these listings are advisory rather than decisive.
RENTCAST_AS_LISTING_SOURCE=true

# -----------------------------------------------------------------------------
# MODULE 2 -- ANTI-BOT SCRAPER FALLBACK (ScrapingBee)
# -----------------------------------------------------------------------------
# https://app.scrapingbee.com/account/manage
SCRAPINGBEE_API_KEY=
# Residential/premium proxies cost more credits but survive portal bot walls.
SCRAPINGBEE_PREMIUM_PROXY=true
# stealth_proxy is the strongest tier (highest credit cost). Use when premium
# alone still gets challenged.
SCRAPINGBEE_STEALTH_PROXY=false
SCRAPINGBEE_RENDER_JS=true
SCRAPINGBEE_COUNTRY_CODE=us
# Milliseconds to wait after page load before extraction.
SCRAPINGBEE_WAIT_MS=4000
# Hard ceiling on scraper credits burned per pipeline run (safety valve).
SCRAPINGBEE_MAX_REQUESTS_PER_RUN=12

# -----------------------------------------------------------------------------
# MODULE 3 -- ENRICHMENT & VALIDATION
# -----------------------------------------------------------------------------

# --- RentCast (rent AVM) -----------------------------------------------------
# https://app.rentcast.io/app/api
RENTCAST_API_KEY=
RENTCAST_BASE_URL=https://api.rentcast.io/v1

# --- HouseCanary (value + rental AVM) ---------------------------------------
# https://api-docs.housecanary.com/  (HTTP Basic: key = user, secret = password)
HOUSECANARY_API_KEY=
HOUSECANARY_API_SECRET=
HOUSECANARY_BASE_URL=https://api.housecanary.com/v2

# --- Miami-Dade County Assessor / GIS (public, no key required) --------------
# Property Appraiser public service proxy -- authoritative sqft & year built.
MIAMIDADE_PA_PROXY_URL=https://www.miamidade.gov/Apps/PA/PApublicServiceProxy/PaServicesProxy.ashx
# ArcGIS parcel layer used as a fallback when the PA proxy is unavailable.
MIAMIDADE_GIS_URL=https://gisweb.miamidade.gov/arcgis/rest/services/MD_Parcels/MapServer/0/query
# Set false to skip county verification entirely.
MIAMIDADE_ENABLED=true

# -----------------------------------------------------------------------------
# ALERTING -- configure at least one channel
# -----------------------------------------------------------------------------

# --- Discord -----------------------------------------------------------------
DISCORD_WEBHOOK_URL=

# --- Slack -------------------------------------------------------------------
SLACK_WEBHOOK_URL=

# --- Email (SMTP) ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Comma-separated recipients
SMTP_TO=
# starttls | ssl | none
SMTP_SECURITY=starttls

# -----------------------------------------------------------------------------
# RUNTIME
# -----------------------------------------------------------------------------
DATABASE_PATH=data/listings.db
LOG_LEVEL=INFO
LOG_FILE=data/miami_bot.log
# Path to the search-criteria file (hard constraints live here, not in code).
CONFIG_PATH=config.yaml

# Global HTTP behaviour
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
# Polite floor between calls to the same host, in seconds.
HTTP_RATE_LIMIT_SECONDS=1.0

# Cache raw provider responses on disk to avoid burning quota during dev.
HTTP_CACHE_ENABLED=false
HTTP_CACHE_DIR=data/cache
HTTP_CACHE_TTL_SECONDS=900

# Daemon mode: minutes between pipeline runs
POLL_INTERVAL_MINUTES=60

# Set true to run the full pipeline without sending alerts or writing state.
DRY_RUN=false
